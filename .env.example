# CYPHER Environment Variables
# Copy this file to .env and replace the placeholder values.

# Cryptographic Keys (Required for signing & verification)
# Set high-entropy random secrets for local HMAC operations:
CYPHER_HMAC_SECRET=replace_with_a_secure_random_hmac_key_for_inference
CYPHER_MANIFEST_SECRET=replace_with_a_secure_random_manifest_hmac_key

# Optional: Path to RSA keys for asymmetric manifest signing and verification
CYPHER_PRIVATE_KEY_PATH=./private_key.pem
CYPHER_PUBLIC_KEY_PATH=./public_key.pem

# API Configuration
PORT=8000
HOST=127.0.0.1

# SQLite Database Storage Paths (Tamper-evident hash-chained logs)
CYPHER_AUDIT_DB=./audit_events.sqlite
CYPHER_PROVENANCE_DB=./data/provenance.db

# Backward Compatibility:
# TRUSTTRACE_CV_HMAC_SECRET, TRUSTTRACE_CV_MANIFEST_SECRET, TRUSTTRACE_PRIVATE_KEY_PATH,
# TRUSTTRACE_PUBLIC_KEY_PATH, TRUSTTRACE_AUDIT_DB, and TRUSTTRACE_PROVENANCE_DB
# are also recognized as legacy fallbacks.

